# Copia este archivo como .env.local y rellena los valores (Project Settings → API).
# Son obligatorias: sin ellas la app no funciona.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (enlaces de invitación y magic link)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional para npm run db:seed: tu correo como superadministrador
SEED_SUPERADMIN_EMAIL=
# Opcional: Google Wallet (solo servidor). Sin estas variables el botón no aparece.
GOOGLE_WALLET_ISSUER_ID=
# JSON de la cuenta de servicio (tal cual o en base64). NUNCA en el repositorio.
GOOGLE_WALLET_SERVICE_ACCOUNT=
# Opcional: Apple Wallet (solo servidor). Sin estas variables el botón de iPhone no aparece.
# Guía: docs/ETAPA-15-APPLE-WALLET.md
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
# Certificado del Pass Type ID y su clave (PEM o base64). NUNCA en el repositorio.
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
# Secreto aleatorio de 32+ caracteres (openssl rand -hex 32). No cambiarlo después de publicar.
APPLE_WALLET_AUTH_SECRET=
# Opcional: Cloudflare Turnstile (anti-bots en la inscripción). Sin estas variables no se exige.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Solo servidor.
TURNSTILE_SECRET_KEY=

# Página de venta (opcionales). WhatsApp: solo dígitos con indicativo; por defecto el de ventas.
NEXT_PUBLIC_SALES_WHATSAPP=
