# Copia este archivo como .env.local y rellena los valores (Project Settings → API).
# Sin estas variables la app funciona en modo demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (enlaces de invitación y magic link)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional para npm run db:seed: tu correo como superadministrador
SEED_SUPERADMIN_EMAIL=
